# Настройки установки. install.sh создаёт этот файл сам и сам заполняет
# ADMIN_PASSWORD, SECRET_KEY и PUBLIC_URL — до запуска здесь править нечего.
#
# Токены ботов и ключ модели сюда НЕ вписывают: их вводит владелец в панели,
# иначе доступы лежали бы в файле на сервере и терялись при переустановке.

# ── Панель ─────────────────────────────────────────────────────────────
ADMIN_LOGIN=admin
# install.sh поставит случайный и покажет его в конце установки
ADMIN_PASSWORD=
# Подпись сессий. Смена разлогинит всех.
SECRET_KEY=

# Адрес, по которому панель открывается снаружи. Идёт в ссылки уведомлений
# и в вебхуки, поэтому должен быть настоящим.
PUBLIC_URL=
HOST=0.0.0.0
PORT=8000

# ── Подписка ASCN ──────────────────────────────────────────────────────
# Установка из маркетплейса ASCN: подписка проверяется, модель отвечает через
# наш шлюз, и по окончании подписки агент замолкает. Своя установка (сами
# поставили, свой ключ модели) живёт с LICENSE_REQUIRED=0 — как раньше.
LICENSE_REQUIRED=0
# Ключ из личного кабинета ASCN. Можно не вписывать: владелец введёт его в
# панели, на странице «Подписка».
LICENSE_KEY=
# Куда установка ходит за состоянием подписки и за ответами модели.
LICENSE_URL=https://ascn.ai
GATEWAY_URL=https://gateway.ascn.ai
# Публичный ключ ASCN в одну строку (\n вместо переводов строк). Им проверяется
# подпись ответа о подписке: без него ответу не верим.
LICENSE_PUBLIC_KEY=

# ── Хранилище ──────────────────────────────────────────────────────────
# Вся переписка, лиды и подключённые боты. Не удалять, бэкап — backup.sh.
DATA_DIR=./data
DB_PATH=./data/data.db
MEDIA_DIR=./data/media
BACKUP_DIR=./data/backups
LOG_DIR=./data/logs
PERSISTENT_STORAGE=0
PORTABLE_MODE=0

# ── Режим приёма сообщений ─────────────────────────────────────────────
# polling — работает на голом IP, домен не нужен. Так и оставьте.
# webhook — нужен HTTPS; переключает nginx.sh, руками менять не надо.
MODE=polling
LOG_LEVEL=INFO
LOG_JSON=0

# ── WhatsApp Business ──────────────────────────────────────────────────
# Только при MODE=webhook. Пусто — канал выключен, остальное работает.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Только латиница: уходит в URL вебхука.
WHATSAPP_VERIFY_TOKEN=

# ── Выгрузка лидов в Google Таблицу (по желанию) ────────────────────────
# Путь к файлу сервисного аккаунта. База знаний в Google не ходит.
GOOGLE_SA_FILE=

# ── Тонкая настройка: менять, только если понимаете зачем ───────────────
# Сколько полей собрать, чтобы завести карточку лида.
LEAD_AFTER_FIELDS=2
# Обход сайта клиента: сколько страниц максимум и размер фрагмента поиска.
CRAWL_MAX_PAGES=80
CHUNK_CHARS=1200
# Шаг фонового цикла и пауза между отправками в рассылке.
TICK_SECONDS=30
SEND_PAUSE_MS=60
