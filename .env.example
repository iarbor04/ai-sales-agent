# ── Каналы клиента ─────────────────────────────────────────────────────
# Telegram: токен от @BotFather. Это канал КЛИЕНТА, не интеграция ASCN.
TELEGRAM_BOT_TOKEN=

# WhatsApp Business через Meta Cloud API. Работает только при MODE=webhook.
# Пусто — канал просто выключен, остальное работает.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=change-me-any-latin-string

# ── Модель ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Панель ─────────────────────────────────────────────────────────────
ADMIN_LOGIN=admin
ADMIN_PASSWORD=смените-обязательно
# Длинная случайная строка. Смена разлогинит всех.
SECRET_KEY=смените-на-случайную-строку

# Адрес, по которому панель доступна снаружи. Нужен для ссылок
# в уведомлениях и для вебхуков.
PUBLIC_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# ── Хранилище ──────────────────────────────────────────────────────────
DB_PATH=data.db
MEDIA_DIR=media

# ── Режим приёма сообщений ─────────────────────────────────────────────
# polling — только Telegram, публичный адрес не нужен
# webhook — Telegram и WhatsApp, нужен HTTPS на PUBLIC_URL
MODE=polling

# ── Тонкая настройка ───────────────────────────────────────────────────
CRAWL_MAX_PAGES=80
CHUNK_CHARS=1200
TICK_SECONDS=30
SEND_PAUSE_MS=60
# сколько полей нужно собрать, чтобы завести карточку лида
LEAD_AFTER_FIELDS=2

# Сервисный аккаунт Google для записи лидов в таблицу.
# База знаний из таблицы работает и без него, по опубликованной ссылке.
GOOGLE_SA_FILE=
SHEETS_SYNC_MINUTES=30
