FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt requirements-portable.txt ./
RUN pip install --no-cache-dir -r requirements-portable.txt
COPY . .
RUN useradd --create-home app && mkdir -p /app/data && chown -R app:app /app
USER app
ENV PORTABLE_MODE=1 DATA_DIR=/app/data HOST=0.0.0.0 PORT=8000
VOLUME ["/app/data"]
EXPOSE 8000
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready')"
CMD ["python", "run.py", "--portable"]
